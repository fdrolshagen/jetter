@tsid = 0{{$random.hexadecimal(12)}}

### GET /users - get all users
GET {{URL}}/users
Authorization: Bearer {{$auth.token("auth-id")}}

### POST /users - create user
POST {{URL}}/users
Authorization: Bearer {{$auth.token("auth-id")}}
Content-Type: application/json

{
  "username": "username",
  "email": "foobar@test.com"
}

### GET /users/{tsid} - get a user by id
GET {{URL}}/users/{{tsid}}
Authorization: Bearer {{$auth.token("auth-id")}}

> {% client.global.set("NEW_TSID", response.body.id) %}

### GET /users/{tsid}/status - wait until processing is DONE
GET {{URL}}/users/{{NEW_TSID}
Authorization: Bearer {{$auth.token("auth-id")}}

#@jetter.while = response.body.id != "1337"
#@jetter.maxIterations = 10
#@jetter.sleep = 2s
#@jetter.onTimeout = continue

### DELETE /users/{tsid} - delete a user by id
DELETE {{URL}}/users/{{NEW_TSID}}
Authorization: Bearer {{$auth.token("auth-id")}}
